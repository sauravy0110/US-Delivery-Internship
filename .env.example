

# LLM provider: "groq" (default, free tier) | "openai" | "gemini" | "mock" (offline, no key needed)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here

# Optional
OPENAI_API_KEY=your_openai_api_key_here       # free: https://console.groq.com/keys
    
GEMINI_API_KEY=your_gemini_api_key_here      # free tier: https://aistudio.google.com/apikey

# Model name for whichever provider is active. Leave unset to use that provider's default
# (groq -> openai/gpt-oss-120b, openai -> gpt-4o-mini, gemini -> gemini-2.0-flash).
# Groq deprecates/renames models periodically — if you get a 404 "model does not exist",
# run: curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# to see your account's current live model list, and set LLM_MODEL to one of those ids.
LLM_MODEL=openai/gpt-oss-120b

# Sampling temperature. Kept low/zero for Task 2 (deterministic account briefs).
LLM_TEMPERATURE=0.2

# Optional fixed seed, passed through where the provider supports it.
LLM_SEED=42

# KB retrieval backend: "embeddings" (SentenceTransformers + FAISS, preferred) or "tfidf"
# (forces the lexical fallback deliberately, e.g. for a fully offline demo/CI run).
KB_RETRIEVAL_MODE=embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
